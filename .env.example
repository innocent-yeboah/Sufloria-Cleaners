# Supabase (required for quote form + /admin dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local admin login
ADMIN_EMAIL=contact@sufloriacleaners.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=long-random-string-at-least-32-chars

# Resend (use a verified domain in production)
RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=Sufloria Cleaners <contact@sufloriacleaners.com>
# Comma-separated list of inboxes that should receive new quote alerts
CONTACT_TO_EMAIL=you@example.com,backup@example.com

# Site
NEXT_PUBLIC_SITE_URL=https://sufloriacleaners.com
NEXT_PUBLIC_WHATSAPP_NUMBER=447386544703

# Optional: Cloudflare Turnstile (leave blank to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
